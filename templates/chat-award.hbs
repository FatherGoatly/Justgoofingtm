<div class="hva-chat-card award {{pool}} {{#if blocked}}blocked{{/if}}">
  <header><i class="{{icon}}"></i> <strong>{{text}}</strong></header>
  <p class="hva-chat-meta">{{actor.name}} · {{category}} · {{localize "HVA.Chat.Natural" natural=natural}}</p>
  <p class="hva-chat-counter"><i class="{{icon}}"></i> {{label}}: {{count}} / {{max}}</p>
</div>
