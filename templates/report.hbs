<section class="tab scrollable {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{#unless report}}<p class="hint">No import has run yet.</p>{{else}}
  <h3>Status: <span class="tag status-{{report.status}}">{{report.status}}</span></h3>
  {{#if report.errors.length}}<ul class="errors">{{#each report.errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  <div class="sbi-summary">
    <span><strong>{{report.actors.length}}</strong> {{localize "SBI.Report.ActorsCreated"}}</span>
    <span><strong>{{report.items.length}}</strong> {{localize "SBI.Report.ItemsCreated"}}</span>
    <span><strong>{{report.embedded.length}}</strong> {{localize "SBI.Report.ItemsEmbedded"}}</span>
    <span><strong>{{report.updated.length}}</strong> {{localize "SBI.Report.Updated"}}</span>
    <span><strong>{{report.skipped.length}}</strong> {{localize "SBI.Report.Skipped"}}</span>
    <span><strong>{{report.macros.length}}</strong> {{localize "SBI.Report.MacrosCreated"}}</span>
  </div>
  <h4>Documents</h4>
  <ul class="sbi-docs">
    {{#each report.actors}}<li><a data-action="openDoc" data-uuid="{{uuid}}"><i class="fa-solid fa-user"></i> {{name}}</a></li>{{/each}}
    {{#each report.items}}<li><a data-action="openDoc" data-uuid="{{uuid}}"><i class="fa-solid fa-suitcase"></i> {{name}}</a></li>{{/each}}
    {{#each report.embedded}}<li><a data-action="openDoc" data-uuid="{{uuid}}"><i class="fa-solid fa-suitcase"></i> {{name}}</a> <span class="hint">on {{actor}}</span></li>{{/each}}
    {{#each report.updated}}<li><a data-action="openDoc" data-uuid="{{uuid}}"><i class="fa-solid fa-pen"></i> {{name}}</a> <span class="hint">{{policy}}</span></li>{{/each}}
    {{#each report.macros}}<li><a data-action="openDoc" data-uuid="{{uuid}}"><i class="fa-solid fa-code"></i> {{name}}</a></li>{{/each}}
  </ul>
  <h4>{{localize "SBI.Report.MechanicsOk"}} ({{report.mechanics.implemented.length}})</h4>
  <ul>{{#each report.mechanics.implemented}}<li><i class="fa-solid fa-check"></i> {{item}}: {{label}} <span class="tag">{{owner}}</span> <span class="tag ok">{{localize "SBI.Report.Verified"}}</span></li>{{/each}}</ul>
  {{#if report.mechanics.review.length}}
  <h4>{{localize "SBI.Report.MechanicsReview"}} ({{report.mechanics.review.length}})</h4>
  <ul>{{#each report.mechanics.review}}<li><i class="fa-solid fa-circle-question"></i> {{item}}: {{label}} <span class="hint">{{reason}}</span></li>{{/each}}</ul>
  {{/if}}
  {{#if report.mechanics.unsupported.length}}
  <h4>{{localize "SBI.Report.MechanicsUnsupported"}} ({{report.mechanics.unsupported.length}})</h4>
  <ul>{{#each report.mechanics.unsupported}}<li><i class="fa-solid fa-hand"></i> {{item}}: {{label}} <span class="hint">{{reason}}</span></li>{{/each}}</ul>
  {{/if}}
  {{#if report.placeholders.length}}
  <h4>Placeholders to replace ({{report.placeholders.length}})</h4>
  <ul>{{#each report.placeholders}}<li>{{name}} <span class="tag">{{hint}}</span> <span class="hint">on {{actor}}</span></li>{{/each}}</ul>
  {{/if}}
  {{#if report.warnings.length}}
  <h4>Warnings ({{report.warnings.length}})</h4>
  <ul class="warnings">{{#each report.warnings}}<li>{{this}}</li>{{/each}}</ul>
  {{/if}}
  <div class="sbi-actions"><button type="button" data-action="copyDiagnostics"><i class="fa-solid fa-copy"></i> Copy diagnostics</button></div>
  {{/unless}}
</section>
