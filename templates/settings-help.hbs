  <dt>{{localize "HVA.Settings.advantagePolicy.OrdinaryOnly"}}</dt><dd>{{localize "HVA.Help.Advantage.ordinaryOnly"}}</dd>
</dl>
<h3>{{localize "HVA.Help.RerollTitle"}}</h3>
