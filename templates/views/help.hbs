<div class="view help-view">
  <header class="view-header"><h2>{{localize "GMMA.Help.Title"}}</h2><p class="view-lead">{{localize "GMMA.Help.Lead"}} <span class="hint">v{{version}}</span></p></header>
  <section class="card"><h3>{{localize "GMMA.Help.HowTitle"}}</h3>
    <ol class="help-steps">
      <li>{{localize "GMMA.Help.Step1"}}</li>
      <li>{{localize "GMMA.Help.Step2"}}</li>
      <li>{{localize "GMMA.Help.Step3"}}</li>
      <li>{{localize "GMMA.Help.Step4"}}</li>
      <li>{{localize "GMMA.Help.Step5"}}</li>
    </ol>
  </section>
  <section class="card"><h3>{{localize "GMMA.Help.ModesTitle"}}</h3>
    <dl class="kv"><dt>{{localize "GMMA.Mode.guided"}}</dt><dd>{{localize "GMMA.Mode.Hint.guided"}}</dd><dt>{{localize "GMMA.Mode.workshop"}}</dt><dd>{{localize "GMMA.Mode.Hint.workshop"}}</dd><dt>{{localize "GMMA.Mode.challenge"}}</dt><dd>{{localize "GMMA.Mode.Hint.challenge"}}</dd></dl>
  </section>
  <section class="card"><h3>{{localize "GMMA.Help.SafetyTitle"}}</h3><p>{{localize "GMMA.Help.Safety1"}}</p><p>{{localize "GMMA.Help.Safety2"}}</p><p>{{localize "GMMA.Help.Safety3"}}</p></section>
  <section class="card"><h3>{{localize "GMMA.Help.StuckTitle"}}</h3><ul><li>{{localize "GMMA.Help.Stuck1"}}</li><li>{{localize "GMMA.Help.Stuck2"}}</li><li>{{localize "GMMA.Help.Stuck3"}}</li><li>{{localize "GMMA.Help.Stuck4"}}</li></ul></section>
  <section class="card"><h3>{{localize "GMMA.Help.KeysTitle"}}</h3><ul><li><kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>A</kbd>: {{localize "GMMA.Help.KeyOpen"}}</li><li><code>/academy</code> {{localize "GMMA.Help.KeyChat"}}</li><li><kbd>Ctrl</kbd>+<kbd>Enter</kbd>: {{localize "GMMA.Help.KeyRun"}}</li><li><kbd>Ctrl</kbd>+<kbd>S</kbd>: {{localize "GMMA.Help.KeySave"}}</li></ul></section>
</div>
